{
  "name": "kesh-gold",
  "displayName": "cmb gold quote",
  "description": "招商银行黄金行情",
  "version": "1.0.2",
  "publisher": "kesh",
  "author": "kesh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:zhaohuang.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zhaohuang.open",
        "title": "cmb gold quote：打开行情"
      }
    ],
    "configuration": {
      "title": "cmb gold quote",
      "properties": {
        "zhaohuang.refreshseconds": {
          "type": "integer",
          "default": 5,
          "minimum": 5,
          "description": "刷新间隔（整数秒，最小为 5）"
        }
      }
    }
  }
}
