{
  "name": "kesh-gold",
  "displayName": "cmb gold quote",
  "description": "招商银行黄金行情",
  "version": "1.0.0",
  "publisher": "kesh",
  "author": "kesh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:zhaohuang.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zhaohuang.open",
        "title": "cmb gold quote：打开行情"
      }
    ],
    "configuration": {
      "title": "cmb gold quote",
      "properties": {
        "zhaohuang.apiurl": {
          "type": "string",
          "default": "https://mbmodule-openapi.paas.cmbchina.com/product/v1/func/market-center",
          "description": "报价接口地址"
        },
        "zhaohuang.refreshseconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "刷新间隔（秒）"
        },
        "zhaohuang.requestparams": {
          "type": "array",
          "default": [
            {
              "prdType": "H",
              "prdCode": ""
            }
          ],
          "description": "接口请求参数"
        },
        "zhaohuang.quotekey": {
          "type": "string",
          "default": "FQAMBPRCZ1",
          "description": "报价对象字段名"
        }
      }
    }
  }
}
